  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Five max, Instagram's cap since Dec 2025. Specific topics, not #fyp. / Cinco no máximo, e de assunto, não #fy."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "\"Stop scrolling\" opener",
      "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b",
      "name": "Video preamble (\"in this video I'm going to show you\")",
      "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji bullet list",
      "fix": "Use a hyphen or a line break. Emoji bullets are the single most template-looking thing in a caption."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "name": "Three or more shouted words in a row",
      "fix": "Caps are a volume knob, not a highlighter. One word, at most."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:follow for more|tag someone who|double tap if|share this if|comment below if)\\b",
      "name": "Reflex follow or tag bait",
      "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."
    },
    {
      "id": "pt-nao-e-sobre",
      "regex": "(?i)\\bnão é (?:só |apenas |somente )?sobre [^.!?\\n]{2,60}[,.]\\s*é sobre\\b",
      "name": "\"Não é sobre X, é sobre Y\"",
      "fix": "Diz direto o Y. A virada é a marca de IA."
    },
    {
      "id": "pt-nao-e-so",
      "regex": "(?i)\\bnão é (?:só|apenas|somente) [^.!?\\n]{2,60}[,.]\\s*é\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Fala a única coisa que você quer dizer. Apaga a metade do setup."
    },
    {
      "id": "pt-nao-so-mas",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:também|tambem)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebra em duas frases ou corta a metade mais fraca."
    },
    {
      "id": "pt-resultado",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o pulo do gato)\\?\\s*$",
      "name": "\"O resultado?\" numa linha só",
      "fix": "Fala o resultado direto, sem a pergunta de suspense."
    },
    {
      "id": "pt-triad",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Tríade \"X, Y e Z.\"",
      "fix": "Três itens com o mesmo peso é ritmo de máquina. Corta um ou dá peso diferente."
    },
    {
      "id": "pt-em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em suma|concluindo|em conclusão)\\b",
      "name": "\"Em resumo\"",
      "fix": "Apaga. Se precisa resumir, o texto tá longo."
    },
    {
      "id": "pt-engagement-bait",
      "regex": "(?i)\\b(?:concorda\\?|o que acha\\?|o que vocês acham\\?|quem mais\\b|tô errado\\?|to errado\\?|estou errado\\?)\\s*$",
      "name": "Pergunta de engajamento no final",
      "fix": "Faz uma pergunta que só quem viu o post consegue responder."
    },
    {
      "id": "pt-stop-scroll",
      "regex": "(?im)^\\s*(?:para de rolar|pare de rolar|não passa(?:\\s+direto)?|espera,? não passa)\\b",
      "name": "\"Para de rolar\"",
      "fix": "Pedir atenção prova que você não conquistou. Abre no resultado."
    },
    {
      "id": "pt-no-video",
      "regex": "(?i)\\b(?:n(?:o|esse|este) (?:vídeo|video|reels?)(?: de hoje)? (?:eu )?vou|hoje eu vou (?:te )?(?:mostrar|ensinar|falar)|vou te (?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo de vídeo",
      "fix": "Apaga e começa no que você ia dizer no segundo seis."
    },
    {
      "id": "pt-follow-bait",
      "regex": "(?i)\\b(?:segue pra mais|siga para mais|marca (?:aquele|um|uma) amig[oa] que|marque alguém que|curte se|dá (?:o|um) like se|comenta aqui embaixo se|ativa o sininho)\\b",
      "name": "Isca de follow/like",
      "fix": "Uma pedida só, ligada ao post. Ou nenhuma."
    },
    {
      "id": "pt-caps-shout",
      "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
      "name": "Três palavras em CAPS seguidas",
      "fix": "Caps em uma palavra no máximo."
    }
  ]
}
